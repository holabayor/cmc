# ==========================================
# ENV TEMPLATE: Creative Create Conference 2026
# ==========================================
# Copy this file to '.env.local' and populate with your database credentials.
# Do NOT commit '.env.local' to public version control.

# --- OPTION A: SUPABASE INTEGRATION (Recommended & Preconfigured) ---
# Retrieve these from your Supabase Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key..."

# --- OPTION B: DIRECT POSTGRESQL POOLING (Alternative) ---
# Connection string from Supabase or any PostgreSQL provider
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"

# --- OPTION C: FIREBASE FIRESTORE INTEGRATION (Alternative) ---
# FIREBASE_PROJECT_ID="your-firebase-project-id"
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n[YOUR-KEY]\n-----END PRIVATE KEY-----\n"
