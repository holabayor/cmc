# ==========================================
# ENV TEMPLATE: Creative Create Conference 2026
# ==========================================
# Copy this file to '.env.local' and populate with your database credentials.
# Do NOT commit '.env.local' to public version control.

# --- OPTION A: FIREBASE FIRESTORE INTEGRATION (Recommended & Active) ---
# Retrieve these credentials from your Firebase Console:
# 1. Project Overview -> Project Settings -> Service Accounts
# 2. Click "Generate new private key". This downloads a JSON file.
# 3. Copy the 'project_id', 'client_email', and 'private_key' values.
# IMPORTANT: In your environment string, verify the private key replaces linebreaks with \n.
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n[YOUR-PRIVATE-KEY-STUFF]\n-----END PRIVATE KEY-----\n"

# --- OPTION B: SUPABASE INTEGRATION (Alternative) ---
# SUPABASE_URL="https://your-project-id.supabase.co"
# SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key..."
